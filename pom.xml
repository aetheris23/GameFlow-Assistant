<?xml version="1.0" encoding="UTF-8"?>
<!--
  Reference build for users who have Maven. The identical project also builds
  with the included build.sh (javac) which needs no external tools beyond the JDK
  plus the vendored sqlite-jdbc jar in ./lib.

  The default build uses a lightweight pure-Java template matcher so it runs on
  low-resource machines with no native binaries. To enable real OpenCV template
  matching via JavaCV, activate the "opencv" dependency profile.
-->
<project xmlns="http://maven.apache.org/xsd/maven-4.0.0.xsd"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/xsd/maven-4.0.0.xsd http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.gameflow</groupId>
    <artifactId>gameflow-assistant</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency> <!-- required by sqlite-jdbc on the classpath -->
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.13</version>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.45.1.0</version>
        </dependency>
    </dependencies>

    <profiles>
        <!--
          Optional: real OpenCV template matching. Note this bundles native
          binaries (larger download) and is disabled by default to honor the
          "low resource usage" requirement.
        -->
        <profile>
            <id>opencv</id>
            <activation><activeByDefault>false</activeByDefault></activation>
            <dependencies>
                <dependency>
                    <groupId>org.bytedeco</groupId>
                    <artifactId>opencv-platform</artifactId>
                    <version>4.10.0-1.5.11</version>
                </dependency>
                <dependency>
                    <groupId>org.bytedeco</groupId>
                    <artifactId>javacv</artifactId>
                    <version>1.5.11</version>
                </dependency>
            </dependencies>
        </profile>
    </profiles>

    <build>
        <finalName>gameflow-assistant</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>4.3.0</version>
            </plugin>
        </plugins>
    </build>
</project>